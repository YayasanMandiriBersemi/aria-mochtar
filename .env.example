# ==============================================================================
# AIRA MOCHTAR — Example Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' and restrict permissions before editing:
#   cp .env.example .env && chmod 600 .env
#
# SECURITY WARNING:
# - Never commit '.env' or real API keys to Git.
# - Production credentials must be at least 12 characters long.
# ==============================================================================

# Runtime Environment: development | test | production
AIRA_ENV=development
AIRA_APP_NAME=AIRA MOCHTAR
AIRA_TIMEZONE=Asia/Jakarta
AIRA_LOG_LEVEL=INFO

# Local Storage & Control Paths
AIRA_DATA_DIR=./data
AIRA_LOG_FILE_PATH=./data/logs/aira.jsonl
AIRA_IPC_SOCKET_PATH=./data/aira.sock

# Database Connection (Stage 1: SQLite WAL; Stage 2+: PostgreSQL)
DATABASE_URL=sqlite:///./data/aira.db

# Google Gemini API Credentials & Model Routing
# Replace placeholder below when configuring live AI calls or production mode:
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Telegram Bot API Ingress (Stage 1 Long-Polling)
# Set TELEGRAM_BOT_ENABLED=true only after providing token and owner user ID(s)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_placeholder
# Comma-separated list of authorized numeric Telegram owner user IDs (e.g., 123456789)
AUTHORIZED_TELEGRAM_USER_IDS=

# Token & Execution Safety Budgets
DAILY_TOKEN_BUDGET_CAP=500000
MAX_INPUT_TOKENS_PER_TURN=16000
MAX_TOOL_ITERATIONS=5

# Optional Local IPC Control Token (for CLI -> Daemon /cancel commands)
AIRA_IPC_AUTH_TOKEN=
